# Example secret variables for BorrowBox deployment.
# Copy this file to secrets.yml and customize with your actual values.
mongodb_uri: "mongodb+srv://<user>:<password>@cluster0.mongodb.net/borrowbox?retryWrites=true&w=majority"
ai_api_key: "your-ai-api-key"
app_port: "5000"
node_env: "production"
